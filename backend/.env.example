# JWT Configuration
# Copy this file to .env and fill with your values.
# Generate a private random JWT secret (at least 32 characters).
# Load .env through IntelliJ EnvFile or your process launcher.
JWT_SECRET=
JWT_EXPIRATION=86400000

# Database Configuration
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# AI Configuration
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
